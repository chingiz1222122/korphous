TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
RECRUITER_CHAT_ID=123456789

DATABASE_PATH=./data/candidates.db
GOOGLE_SHEET_NAME=WB Candidates
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google_service_account.json

MIN_ANSWER_LENGTH=15
MIN_CASE_ANSWER_LENGTH=40

# Если заполнить WEBHOOK_BASE_URL, бот будет работать через webhook, иначе polling.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=wb-hiring-secret
APP_PORT=8080
